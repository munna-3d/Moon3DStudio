// Moon 3D Studio - Production PostgreSQL Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN") // ADMIN, EDITOR
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@index([email])
}

model Project {
  id                String         @id @default(cuid())
  title             String
  slug              String         @unique
  shortDescription  String
  description       String
  category          String         @default("VEHICLES") // VEHICLES, HARD SURFACE, ENVIRONMENT, OTHER
  categoryLabel     String         @default("VEHICLE")
  featured          Boolean        @default(false)
  published         Boolean        @default(true)
  sortOrder         Int            @default(0)
  heroImage         String
  thumbnailImage    String?
  triangleCount     String?
  textureResolution String?
  engine            String?
  software          String         @default("[]") // JSON string array
  services          String         @default("[]") // JSON string array
  client            String?
  year              String         @default("2026")
  actionText        String?        @default("EXPLORE MODEL ↗")
  seoTitle          String?
  seoDescription    String?
  ogImage           String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  images            ProjectImage[]

  @@index([slug])
  @@index([published])
  @@index([featured])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  altText   String?
  caption   String?
  sortOrder Int      @default(0)
  imageType String   @default("FINAL") // HERO, FINAL, DETAIL, WIREFRAME, UV, TEXTURE, ENGINE, OTHER
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Service {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  shortDesc      String
  fullDesc       String
  iconName       String   @default("box") // box, gamepad, car, shield, sparkles, layers
  heroImage      String?
  highlights     String   @default("[]") // JSON string array
  deliverables   String   @default("[]") // JSON string array
  published      Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  company    String?
  quote      String
  project    String?
  image      String?
  published  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published])
}

model ProjectEnquiry {
  id           String              @id @default(cuid())
  name         String
  email        String
  company      String?
  projectType  String              @default("General 3D")
  description  String
  timeline     String?             @default("Within 1 Month")
  budget       String?             @default("$1000 - $3000")
  referenceUrl String?
  status       String              @default("NEW") // NEW, CONTACTED, IN_PROGRESS, COMPLETED, ARCHIVED, SPAM
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  attachments  EnquiryAttachment[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model EnquiryAttachment {
  id           String         @id @default(cuid())
  enquiryId    String
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  createdAt    DateTime       @default(now())

  enquiry      ProjectEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
}
